# Supabase (optional) — leads are stored in the `estimate_requests` table and
# photos in the `project-photos` storage bucket. See supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Supabase Edge Function name that sends notification emails
# (e.g. via Resend/Postmark). Invoked after a lead is stored.
VITE_NOTIFY_FUNCTION=notify-estimate
